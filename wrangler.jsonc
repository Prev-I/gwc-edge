{
  "name": "gwc-edge",
  "main": "crates/gwc-worker/build/index.js",
  "compatibility_date": "2026-10-20",
  // A template (ADR-0015): scripts/deploy.sh renders wrangler.deploy.json
  // from it, with the database id, CANONICAL_URL and the Custom Domain route.
  // Never commit those here.
  //
  // One canonical URL (docs/protocol.md): no *.workers.dev address and no
  // preview URLs. The Worker is reached only through its Custom Domain.
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    // worker-build is pinned and installed by mise (see mise.toml).
    // GWC_GIT_SHA is compiled in and shown on the landing page and /stats.
    "command": "cd crates/gwc-worker && GWC_GIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo unknown) worker-build --release",
    // wrangler watches ./src by default, which does not exist here.
    "watch_dir": ["crates/gwc-core/src", "crates/gwc-worker/src"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gwc-edge",
      // No database_id: local development needs none, and deploy.sh adds
      // the real one to the rendered config.
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // This cache's public URL, exactly as clients store it: plain http://,
    // the custom domain, no alias. A placeholder for local runs; deploy.sh
    // sets it from GWC_CANONICAL_URL.
    "CANONICAL_URL": "http://gwc.example.org/",
    "HOSTFILE_COUNT": "20",
    "URLFILE_COUNT": "20",
    // Comma-separated vendor codes that get no hosts. CRUX is CruxP2P.
    "CLIENT_DENYLIST": "CRUX"
  },
  // Rate limiting (ADR-0005): per source and kind, no D1 writes. The
  // namespace ids only need to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "GET_LIMITER", "namespace_id": "4801", "simple": { "limit": 2, "period": 60 } },
    { "name": "UPDATE_LIMITER", "namespace_id": "4802", "simple": { "limit": 1, "period": 60 } }
  ],
  "triggers": {
    // Verifies hubs and caches, then renders the hostfile snapshot and the
    // hourly stats (ADR-0012).
    "crons": ["*/10 * * * *"]
  },
  // Workers Logs: every invocation, and the one JSON line per request the
  // Worker writes (docs/operations.md). Free plan: 200,000 events a day, 7 days.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  }
}
